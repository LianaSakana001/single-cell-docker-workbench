# Single registration form for one host account.
# Copy this file to workbench.env, then replace every example value.

# Unique names: use a different suffix for every account on a shared Docker host.
COMPOSE_PROJECT_NAME=scw_analyst
CONTAINER_NAME=scw-analyst
IMAGE_NAME=local/single-cell-workbench-analyst
IMAGE_TAG=2026-07-v1

# Pin the upstream GPU image. Change this only after checking driver/CUDA compatibility.
BASE_IMAGE=ghcr.io/scverse/rapids-singlecell-cu12@sha256:733ff6eb8086203d202c895bd3eda7b47d1c743e0f76255368617330609b6ca2

# Run id -u, id -g, and id -G on the Linux host.
CONTAINER_USER=analyst
HOST_UID=1000
HOST_GID=1000
# A supplementary host group used to read shared data. If none is needed, repeat HOST_GID.
HOST_EXTRA_GID=1000

# One writable workbench and three narrowly scoped read-only inputs.
# Paths must already exist. Do not use broad roots such as /, /home, or /data.
WORKSPACE_HOST=/srv/single-cell/analyst/workbench
INPUT_A_HOST=/srv/single-cell/shared/raw-matrices
INPUT_B_HOST=/srv/single-cell/shared/reference-h5ad
INPUT_FILE_HOST=/srv/single-cell/shared/metadata/annotated.h5ad
INPUT_FILE_NAME=annotated.h5ad

# Hard limits. Setting memory-swap equal to memory disables additional swap.
MEM_LIMIT=150g
MEMSWAP_LIMIT=150g
SHM_SIZE=16g
CPU_LIMIT=32
THREAD_LIMIT=16
